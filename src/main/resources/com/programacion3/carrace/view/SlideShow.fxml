<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" styleClass="slideshow-root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" top="30.0" />
         </padding>
         <children>
            <Label fx:id="greetingLabel" styleClass="greeting" text="&quot;Welcome to the grand Cuautitlan Izcalli, Edo-MEX grand Prix&quot;" />
            <Label styleClass="subtitle" text="Meet today's drivers" />
         </children>
      </VBox>
   </top>
   <center>
      <ImageView fx:id="carImageView" fitHeight="340.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
         <image>
            <Image url="@../images/tsuru.png" />
         </image>
      </ImageView>
   </center>
   <bottom>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" />
         </padding>
         <children>
            <Label fx:id="captionLabel" styleClass="caption" text="Car #88 (Red Tsuru Tuneado)" />
            <ProgressBar prefWidth="400.0" progress="0.2" />
            <Button fx:id="skipButton" mnemonicParsing="false" styleClass="skip-button" text="Skip intro" />
         </children>
      </VBox>
   </bottom>
</BorderPane>
